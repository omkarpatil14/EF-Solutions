# Public site URL used for sitemap, canonicals, and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.moneymattersbyet.com

# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=you@yourdomain.com

# Must be a verified domain sender in Resend (use onboarding@resend.dev for local testing)
CONTACT_FROM_EMAIL=MoneyMatters <contact@yourdomain.com>
